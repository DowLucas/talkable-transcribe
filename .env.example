# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_api_key_here

# Audio settings
AUDIO_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024

# Hotkey settings
HOTKEY_CTRL=true
HOTKEY_SHIFT=true
HOTKEY_KEY=r

# Require specific right modifiers (true = right side only, false = either side)
HOTKEY_CTRL_R=true
HOTKEY_SHIFT_R=true
